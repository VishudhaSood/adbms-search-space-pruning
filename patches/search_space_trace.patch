 add_path_precheck_hook_type add_path_precheck_hook = NULL;
+
+/* ---- ADBMS search-space trace (Vishudha/Gourav) ---- */
+static const char *
+trace_type_name(NodeTag t)
+{
+	switch (t)
+	{
+		case T_SeqScan: return "SeqScan";
+		case T_IndexScan: return "IndexScan";
+		case T_IndexOnlyScan: return "IndexOnlyScan";
+		case T_BitmapHeapScan: return "BitmapHeapScan";
+		case T_NestLoop: return "NestLoop";
+		case T_MergeJoin: return "MergeJoin";
+		case T_HashJoin: return "HashJoin";
+		case T_Sort: return "Sort";
+		case T_IncrementalSort: return "IncrementalSort";
+		case T_Material: return "Material";
+		case T_Memoize: return "Memoize";
+		case T_Result: return "Result";
+		case T_Gather: return "Gather";
+		case T_GatherMerge: return "GatherMerge";
+		default: return "Other";
+	}
+}
+
+static const char *
+trace_kind_name(RelOptKind k)
+{
+	switch (k)
+	{
+		case RELOPT_BASEREL: return "base";
+		case RELOPT_JOINREL: return "join";
+		case RELOPT_UPPER_REL: return "upper";
+		default: return "other";
+	}
+}
+
+/* One log line per path event: kept / rejected / evict / survivor */
+static void
+trace_path(const char *what, RelOptInfo *rel, Path *p)
+{
+	const char *outer = "-";
+	const char *inner = "-";
+
+	if (IsA(p, NestPath) || IsA(p, MergePath) || IsA(p, HashPath))
+	{
+		JoinPath   *jp = (JoinPath *) p;
+
+		outer = bmsToString(jp->outerjoinpath->parent->relids);
+		inner = bmsToString(jp->innerjoinpath->parent->relids);
+	}
+	elog(LOG, "TRACE %s kind=%s rels=%s type=%s outer=%s inner=%s startup=%.2f total=%.2f rows=%.0f keys=%d disabled=%d",
+		 what, trace_kind_name(rel->reloptkind), bmsToString(rel->relids),
+		 trace_type_name(p->pathtype), outer, inner,
+		 p->startup_cost, p->total_cost, p->rows, list_length(p->pathkeys), p->disabled_nodes);
+}
+/* ---- end trace ---- */
 add_partial_path_precheck_hook_type add_partial_path_precheck_hook = NULL;
 
