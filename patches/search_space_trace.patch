diff --git a/src/backend/optimizer/util/pathnode.c b/src/backend/optimizer/util/pathnode.c
index 5303231d02..1b784960f0 100644
--- a/src/backend/optimizer/util/pathnode.c
+++ b/src/backend/optimizer/util/pathnode.c
@@ -46,6 +46,120 @@ typedef enum
 add_path_hook_type add_path_hook = NULL;
 add_partial_path_hook_type add_partial_path_hook = NULL;
 add_path_precheck_hook_type add_path_precheck_hook = NULL;
+
+/* ---- ADBMS search-space trace (Vishudha/Gourav) ---- */
+#include "portability/instr_time.h"
+extern instr_time trace_clock_start;
+extern double trace_elapsed_us(void);
+
+instr_time	trace_clock_start;
+
+/* microseconds since the stopwatch was started for this query */
+double
+trace_elapsed_us(void)
+{
+	instr_time	now;
+
+	INSTR_TIME_SET_CURRENT(now);
+	INSTR_TIME_SUBTRACT(now, trace_clock_start);
+	return INSTR_TIME_GET_DOUBLE(now) * 1000000.0;
+}
+
+static const char *
+trace_type_name(NodeTag t)
+{
+	switch (t)
+	{
+		case T_SeqScan: return "SeqScan";
+		case T_IndexScan: return "IndexScan";
+		case T_IndexOnlyScan: return "IndexOnlyScan";
+		case T_BitmapHeapScan: return "BitmapHeapScan";
+		case T_NestLoop: return "NestLoop";
+		case T_MergeJoin: return "MergeJoin";
+		case T_HashJoin: return "HashJoin";
+		case T_Sort: return "Sort";
+		case T_IncrementalSort: return "IncrementalSort";
+		case T_Material: return "Material";
+		case T_Memoize: return "Memoize";
+		case T_Result: return "Result";
+		case T_Gather: return "Gather";
+		case T_GatherMerge: return "GatherMerge";
+		default: return "Other";
+	}
+}
+
+static const char *
+trace_kind_name(RelOptKind k)
+{
+	switch (k)
+	{
+		case RELOPT_BASEREL: return "base";
+		case RELOPT_JOINREL: return "join";
+		case RELOPT_UPPER_REL: return "upper";
+		default: return "other";
+	}
+}
+
+/* ADBMS trace: first sort key of a path as "alias.column" (prof's point 7) */
+#include "parser/parsetree.h"
+extern PlannerInfo *trace_root;
+PlannerInfo *trace_root = NULL;
+
+static const char *
+trace_sortkey(Path *p)
+{
+	PathKey    *pk;
+	ListCell   *lc;
+
+	if (p->pathkeys == NIL || trace_root == NULL || p->parent == NULL)
+		return "-";
+	pk = (PathKey *) linitial(p->pathkeys);
+	foreach(lc, pk->pk_eclass->ec_members)
+	{
+		EquivalenceMember *em = (EquivalenceMember *) lfirst(lc);
+		Expr	   *e = em->em_expr;
+		Var		   *v;
+		RangeTblEntry *rte;
+
+		while (e && IsA(e, RelabelType))
+			e = ((RelabelType *) e)->arg;
+		if (e == NULL || !IsA(e, Var) || em->em_is_const ||
+			!bms_is_subset(em->em_relids, p->parent->relids))
+			continue;
+		v = (Var *) e;
+		if (v->varlevelsup != 0 || v->varattno <= 0 ||
+			v->varno < 1 || (int) v->varno >= trace_root->simple_rel_array_size)
+			continue;
+		rte = trace_root->simple_rte_array[v->varno];
+		if (rte == NULL || rte->eref == NULL)
+			continue;
+		return psprintf("%s.%s", rte->eref->aliasname,
+						get_rte_attribute_name(rte, v->varattno));
+	}
+	return "-";
+}
+
+/* One log line per path event: kept / rejected / evict / survivor */
+static void
+trace_path(const char *what, RelOptInfo *rel, Path *p)
+{
+	const char *outer = "-";
+	const char *inner = "-";
+
+	if (IsA(p, NestPath) || IsA(p, MergePath) || IsA(p, HashPath))
+	{
+		JoinPath   *jp = (JoinPath *) p;
+
+		outer = bmsToString(jp->outerjoinpath->parent->relids);
+		inner = bmsToString(jp->innerjoinpath->parent->relids);
+	}
+	elog(LOG, "TRACE %s kind=%s rels=%s type=%s outer=%s inner=%s startup=%.2f total=%.2f rows=%.0f keys=%d sortkey=%s disabled=%d t=%.1f",
+		 what, trace_kind_name(rel->reloptkind), bmsToString(rel->relids),
+		 trace_type_name(p->pathtype), outer, inner,
+		 p->startup_cost, p->total_cost, p->rows, list_length(p->pathkeys), trace_sortkey(p), p->disabled_nodes,
+		 trace_elapsed_us());
+}
+/* ---- end trace ---- */
 add_partial_path_precheck_hook_type add_partial_path_precheck_hook = NULL;
 
